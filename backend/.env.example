DATABASE_URL=sqlite:///./app.db
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Leave unset normally. Set to 0 to force CPU if Ollama reports a CUDA error.
# OLLAMA_NUM_GPU=0
LLM_TIMEOUT_SECONDS=120
# The embedding model (a Hugging Face name; about 2 GB the first time) and the minimum similarity for a passage to count.
# After changing the model, run: python -m scripts.rebuild_index   (Docker: docker compose exec backend python -m scripts.rebuild_index)
# EMBEDDING_MODEL=BAAI/bge-m3
# RAG_MIN_SCORE=0.5
# After the search, a second model (about 2 GB the first time, 1 GB of VRAM) puts RAG_CANDIDATES chunks in order and the best 4 are kept.
# RAG_RERANK=true
# RAG_CANDIDATES=10
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
