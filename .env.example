# Settings for "docker compose up". Copy this file to .env (it is git-ignored, never commit it) and fill in SECRET_KEY.

# Required. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. The defaults are shown.
# Ollama runs on your own machine; from inside a container it is reached as host.docker.internal.
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:3b
# Set to 0 to force CPU if Ollama reports a CUDA error.
# OLLAMA_NUM_GPU=0
# LLM_TIMEOUT_SECONDS=120
# Reranking puts the best 10 passages in order with a second model (about 2 GB to download, downloaded at the first question).
# Off here by default: the container has no GPU and on its CPU it would make every question slower.
# RAG_RERANK=false

# The ports on your machine. Change them when 8000 or 3000 is already in use (for example by the dev servers).
# The backend port is built into the frontend image, so after a change run: docker compose up --build
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
